{
  "name": "hezu-life-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "合租生活管家 —— 室友账单分摊、值日排班、公告与公共物品管理",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-phase2.mjs",
    "db:local": "wrangler d1 migrations apply hezu-db --local",
    "db:remote": "wrangler d1 migrations apply hezu-db --remote",
    "db:new": "wrangler d1 migrations create hezu-db",
    "db:verify": "node scripts/verify-integrity.mjs --remote",
    "db:verify:local": "node scripts/verify-integrity.mjs --local",
    "cpu:probe": "node scripts/measure-cpu.mjs",
    "cpu:report": "node scripts/measure-cpu.mjs --report",
    "cpu:samples": "node scripts/measure-cpu.mjs --samples",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
