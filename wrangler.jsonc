{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hezu-life-manager",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },

  // 静态资源：Vite 构建产物。SPA 路由回退到 index.html。
  // run_worker_first 只放行 /api/*，其余请求直接走静态资源，不消耗 Worker 调用次数。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // 由 `npx wrangler d1 create hezu-db` 创建（区域 WNAM）。
  // 注意：D1 的「主区域」在创建时就固定了，之后改不了；
  // 它决定写操作和读一致性检查要跑到哪个大洲，与边缘节点的位置无关。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hezu-db",
      "database_id": "f0b2f24a-cc81-49d2-93da-df2970debdcb"
    }
  ]
}
